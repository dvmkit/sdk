{
  "package": "@dvmkit/sdk",
  "version": "0.25.0",
  "storeContracts": {
    "StreamableJobStore.getMessages": {
      "options": "optional { includeHeld?: boolean }",
      "includeHeld": "returns all verified messages for snapshot reconstruction, independently of the pending-payment delivery cutoff"
    },
    "StreamableJobStore.appendOutgoing": {
      "options": "optional { appendId?: string, ... }",
      "appendId": "a retry with the same job and append identity returns its original sequence without reapplying counters, including after terminal log cleanup",
      "terminalAsk": "a prompt or payment-request on a job that is already terminal is refused with JobEndedError and writes nothing; a payment-request finishes the job's running piece in the same transaction, at opts.finishedChargeMicro when that is below its price"
    },
    "StreamableJobStore.failJob": {
      "optional": true,
      "behavior": "atomically fail a nonterminal job with a cancel reason and its verified durable history"
    },
    "StreamableJobStore.verifyAndCredit": {
      "creditRefused": "optional; the built-in stores verify the message but apply no credit delta or binding to a job that already ended, and return creditRefused: \"job_ended\"; a store that omits it is treated as having applied the delta",
      "landedAsBalance": "optional opts.landedAsBalance; the built-in stores record the payment with status balance, kept out of message history and handler replay because it paid no ask; credit must be null",
      "piece": "optional credit.piece; the built-in stores append it as a running piece, bought by this payment's seq, only while the job is live and its row is bound to credit.piece.drawId"
    },
    "StreamableJobStore.declineJob": {
      "optional": true,
      "behavior": "atomically end a nonterminal job with an open prompt or payment-request as cancelled by the caller, releasing the running piece; no_open_ask when nothing is open"
    },
    "JobRecord.pieces": {
      "ownership": "written from the snapshot only on insert; afterwards only the transactional paths change it, and the first terminal write ends the running piece and freezes JobRecord.settlement",
      "customStores": "a store that saves the terminal snapshot as given keeps the settlement the SDK froze on it from the job's pieces; a draw with pieces but no frozen settlement is settled from those pieces and the snapshot's ending"
    }
  },
  "wireContracts": {
    "signatureRequired": {
      "fixture": "protocol-fixtures/signature-required-v1.json",
      "status": 401,
      "subReason": "signature_required",
      "behavior": "no envelope fields on a request requiring authentication; partial or invalid envelopes retain signature_invalid"
    },
    "callerDeadline": {
      "fixture": "protocol-fixtures/caller-deadline-v1.json",
      "optionalFields": [
        "prompt.content.expires_at_ms",
        "payment-request.content.expires_at_ms"
      ],
      "unit": "integer Unix milliseconds"
    },
    "upfrontPayment": {
      "fixture": "protocol-fixtures/upfront-payment-v1.json",
      "optionalFields": [
        "upfront_payment"
      ],
      "unit": "integer millisatoshis; optional integer credit micro-units and native atomic units"
    },
    "receiptPending": {
      "fixture": "protocol-fixtures/job-receipt-pending-v1.json",
      "optionalFields": [
        "receipt_pending"
      ],
      "behavior": "true on terminal responses while a configured signed receipt is not durably stored; omitted once receipt is present or receipts are disabled"
    },
    "nut24InlineResult": {
      "fixture": "protocol-fixtures/nut24-inline-result-v1.json",
      "behavior": "unsigned NUT-24 paid submits and replays return completed results inline within the configured wait; running jobs fall back to 202; completed artifact results include durable messages when their serialized UTF-8 array is at most 1048576 bytes and content is available"
    },
    "cardCreditFunding": {
      "fixture": "protocol-fixtures/credit-fund-stripe-v1.json",
      "optionalFields": [
        "credit.stripe"
      ],
      "unit": "integer USD micro-units on the wire; integer cents on the MPP challenge",
      "behavior": "stripe is a credit funding rail only; POST /v1/credit fund with method stripe issues and accepts an MPP method=\"stripe\" charge, booking one funding lot per PaymentIntent; /v1/job never offers it",
      "callerTerms": "CreditTerms.stripe optionally carries network_id (string), min_micro (positive safe integer USD micro-units), and currency (usd); parseCreditTerms and parseCreditMenu preserve only those fields and reject terms with a malformed stripe block",
      "paymentIntentMetadata": {
        "dvmkit_dvm_id": "server canonicalDvmId, falling back to dvmId; omitted without identity; sent on creation including declined confirmations; credential metadata cannot override it",
        "chargeContext": "StripeCreditRail.charge accepts optional canonicalDvmId supplied by the server; existing mpp_* metadata and idempotency keys are preserved",
        "legacyReplay": "HTTP 400 idempotency_error permits one retry without the new metadata under the same key to recover a pre-upgrade charge; existing PaymentIntents keep their original metadata"
      }
    },
    "cardCreditRefund": {
      "fixture": "protocol-fixtures/credit-drain-stripe-v1.json",
      "optionalFields": [
        "drain.refund_ids",
        "drain.card_refund",
        "credit.refund_drain_id"
      ],
      "unit": "integer USD micro-units for the drained credit; integer cents for refunds and the fee share",
      "behavior": "POST /v1/credit drain with method stripe and no payout refunds card-funded credit to the card as partial refunds of the funding PaymentIntents, oldest first, less the refund's proportional share of Stripe's processing fee; card credit drains on no other method and stripe drains no other credit; a refund Stripe does not finish leaves the drain pending and a poll retries it; an expired card balance is refunded the same way and the credit closes (credit_closed)"
    },
    "paymentInProgress": {
      "fixture": "protocol-fixtures/payment-in-progress-v1.json",
      "status": 409,
      "behavior": "a cancel, or a message that would end a job, waits at most 5 seconds for a payment on that job being verified, then answers payment_in_progress with Retry-After and changes nothing"
    },
    "pieceSettlement": {
      "fixture": "protocol-fixtures/piece-settlement-v1.json",
      "optionalFields": [
        "payment-request.content.charged_if_declined_micro",
        "receipt.settlement"
      ],
      "unit": "integer micro-units of the job credit's currency",
      "behavior": "each payment buys the next piece of work and a piece finishes at the next payment-request or completion; every ending charges finished pieces, a caller cancel also charges the running piece, and failure, decline and expiry release it; decline answers 201 or 409 no_open_ask; receipt credit.amount is the charged amount"
    }
  },
