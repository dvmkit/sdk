{
  "wire_path": "/v1/info → capabilities.<name>.pricing.rates",
  "description": "A capability's rate card. Servers publish the declared array byte-for-byte: same order, same strings, no trimming or normalisation. Servers refuse a declaration that breaks a limit, so clients may apply the same limits and drop nothing a conforming server sends.",
  "limits": {
    "min_entries": 1,
    "max_entries": 5,
    "keys": [
      "label",
      "amount",
      "currency",
      "per"
    ],
    "required_keys": [
      "amount",
      "currency",
      "per"
    ],
    "currency": "USD",
    "amount_pattern": "^\\d+(\\.\\d+)?$",
    "amount_above_zero": true,
    "amount_max_length": 12,
    "text_fields": [
      "label",
      "per"
    ],
    "text_min_length": 1,
    "text_max_length": 24,
    "text_edge_whitespace": false
  },
